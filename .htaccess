# ========================================
# 《绛唇解语花》性能优化配置
# Apache .htaccess Configuration
# ========================================

# ----------------------------------------
# 启用压缩 (Gzip Compression)
# ----------------------------------------
<IfModule mod_deflate.c>
    # 压缩 HTML
    AddOutputFilterByType DEFLATE text/html

    # 压缩 CSS
    AddOutputFilterByType DEFLATE text/css

    # 压缩 JavaScript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript

    # 压缩 XML
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml

    # 压缩 JSON
    AddOutputFilterByType DEFLATE application/json

    # 压缩字体
    AddOutputFilterByType DEFLATE font/truetype
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # 压缩图片
    AddOutputFilterByType DEFLATE image/svg+xml

    # 压缩 Markdown
    AddOutputFilterByType DEFLATE text/markdown
    AddOutputFilterByType DEFLATE text/plain
</IfModule>

# ----------------------------------------
# 浏览器缓存 (Browser Caching)
# ----------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # 默认缓存时间
    ExpiresDefault "access plus 1 month"

    # HTML 文件 - 短缓存，方便更新
    ExpiresByType text/html "access plus 1 hour"

    # CSS 和 JavaScript - 长缓存
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # 图片 - 长缓存
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    # 字体 - 长缓存
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Markdown 文件 - 中等缓存
    ExpiresByType text/markdown "access plus 1 week"
    ExpiresByType text/plain "access plus 1 week"

    # XML 和 JSON - 短缓存
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
</IfModule>

# ----------------------------------------
# 缓存控制头 (Cache-Control Headers)
# ----------------------------------------
<IfModule mod_headers.c>
    # HTML - 必须重新验证
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, must-revalidate, max-age=3600"
    </FilesMatch>

    # CSS 和 JavaScript - 可缓存
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, immutable, max-age=31536000"
    </FilesMatch>

    # 图片 - 可缓存
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico)$">
        Header set Cache-Control "public, immutable, max-age=31536000"
    </FilesMatch>

    # 字体 - 可缓存
    <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
        Header set Cache-Control "public, immutable, max-age=31536000"
    </FilesMatch>

    # Markdown - 中等缓存
    <FilesMatch "\.(md|markdown)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # 移除 ETag（简化缓存验证）
    Header unset ETag
    FileETag None

    # 安全头
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------
# 预加载资源 (Resource Preload)
# ----------------------------------------
<IfModule mod_headers.c>
    # 首页预加载关键CSS
    <FilesMatch "index\.html$">
        Header add Link "</css/navigation.css>; rel=preload; as=style"
    </FilesMatch>

    # 阅读器预加载关键资源
    <FilesMatch "reader\.html$">
        Header add Link "</css/navigation.css>; rel=preload; as=style"
        Header add Link "</js/navigation.js>; rel=preload; as=script"
    </FilesMatch>
</IfModule>

# ----------------------------------------
# MIME 类型配置
# ----------------------------------------
<IfModule mod_mime.c>
    # JavaScript
    AddType application/javascript js

    # CSS
    AddType text/css css

    # HTML
    AddType text/html html htm

    # 图片
    AddType image/svg+xml svg svgz
    AddType image/webp webp

    # 字体
    AddType font/ttf ttf
    AddType font/otf otf
    AddType application/font-woff woff
    AddType application/font-woff2 woff2

    # Markdown
    AddType text/markdown md markdown
    AddType text/plain txt

    # 支持 SVG 压缩
    AddEncoding gzip svgz
</IfModule>

# ----------------------------------------
# 字符编码
# ----------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json .md .txt
</IfModule>

# ----------------------------------------
# 禁止目录浏览
# ----------------------------------------
Options -Indexes

# ----------------------------------------
# 自定义错误页面
# ----------------------------------------
ErrorDocument 404 /index.html

# ----------------------------------------
# URL 重写（如果需要）
# ----------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 强制 HTTPS (可选，取消注释启用)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # 移除 .html 扩展名 (可选)
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteCond %{REQUEST_FILENAME}.html -f
    # RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>

# ----------------------------------------
# 安全配置
# ----------------------------------------
# 禁止访问敏感文件
<FilesMatch "(\.(git|gitignore|htaccess|htpasswd|env|log)|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 禁止访问隐藏文件
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ----------------------------------------
# 性能优化建议
# ----------------------------------------
# 1. 启用 HTTP/2 (需要服务器支持)
# 2. 考虑使用 CDN 加速静态资源
# 3. 定期清理未使用的资源
# 4. 压缩图片到合适大小
# 5. 使用 WebP 格式图片（如果浏览器支持）
